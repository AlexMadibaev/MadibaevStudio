# Public canonical URL used by metadata and secure-cookie detection.
NEXT_PUBLIC_SITE_URL=https://madibaevstudio.online

# Required server-only admin credentials. Use long random values and never commit .env.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Secure cookies should stay enabled in production behind HTTPS.
MGS_COOKIE_SECURE=true

# Optional server-only OpenRouter access for admin copy/SEO tools.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Docker sets MGS_DATA_DIR=/data and persists it in the mgs_data volume.
# For Vercel instead, leave MGS_DATA_DIR unset and connect a private Blob store.
BLOB_READ_WRITE_TOKEN=
