# Public canonical URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required server-only admin credentials. Never commit real values.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Local/self-hosted persistent JSON storage. Docker overrides this to /data.
MGS_DATA_DIR=.data
MGS_COOKIE_SECURE=false

# On Vercel, leave MGS_DATA_DIR unset and connect a private Blob store instead.
BLOB_READ_WRITE_TOKEN=

# Optional server-only OpenRouter access for SEO and copywriting tools in the admin editor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
