# Public canonical URL. Set this after the first Vercel deployment creates its URL.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Server-only admin credentials. Never commit real values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Added automatically after connecting a private Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Server-only OpenRouter access for SEO and copywriting tools in the admin editor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
