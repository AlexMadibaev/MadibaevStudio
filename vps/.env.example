# Domain without protocol. DNS A/AAAA records must point to the VPS.
SITE_DOMAIN=madibaevstudio.online
ACME_EMAIL=admin@madibaevstudio.online
NEXT_PUBLIC_SITE_URL=https://madibaevstudio.online

# Required server-only secrets. Replace before first start.
ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS

# Optional admin AI helper.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
