# Domain without protocol. DNS A/AAAA records must point to the VPS.
SITE_DOMAIN=madibaevstudio.online
ACME_EMAIL=admin@madibaevstudio.online
NEXT_PUBLIC_SITE_URL=https://madibaevstudio.online

# Google-only owner authentication. Keep every real value only in VPS .env.
ADMIN_SESSION_SECRET=CHANGE_ME_USE_AT_LEAST_64_RANDOM_CHARACTERS
ADMIN_GOOGLE_EMAIL=owner@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://madibaevstudio.online/api/admin/google/callback

# Cloudflare Turnstile for the public enquiry form.
# Create a widget for madibaevstudio.online, then enable TURNSTILE_REQUIRED.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false

# Set true only when traffic reaches the VPS through Cloudflare proxy and
# cf-connecting-ip can be trusted as the real client address.
MGS_TRUST_CLOUDFLARE=false

# Optional admin AI helper. The API is authenticated, payload-limited and rate-limited.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Daily off-site backup settings used by scripts/backup-data.sh.
# Example: my-backup:madibaevstudio-production
RCLONE_REMOTE=
BACKUP_LOCAL_DAYS=7
BACKUP_REMOTE_DAYS=30
BACKUP_SITE_SLUG=madibaevstudio
